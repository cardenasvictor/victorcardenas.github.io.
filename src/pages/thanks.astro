---
import Base from '../layouts/Base.astro';
---
<Base title="Message received" closing={false} description="Thank you — your message has been received.">
  <section class="section" style="min-height:60vh;display:flex;align-items:center">
    <div class="container" style="max-width:640px">
      <span class="eyebrow">Contact</span>
      <h1 class="display-2" style="margin:1rem 0 1.25rem">Thank you — message received.</h1>
      <p class="body-lg" style="margin-bottom:2rem">I read every message personally and typically reply within two business days. If your matter is time-sensitive, booking a call is the fastest route.</p>
      <div class="hero-ctas">
        <a href="https://calendly.com/cardenas-victor/30min" class="btn btn-primary" rel="noopener" target="_blank">Book a Call</a>
        <a href="./" class="btn btn-secondary">Back to Home</a>
      </div>
    </div>
  </section>
</Base>
