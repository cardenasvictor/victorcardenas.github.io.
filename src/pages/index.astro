---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import { metrics, researchLines, bio } from '../data/content';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Home">
  <Hero
    title="Climate risk and resilience advisory"
    sub="Climate adaptation and sustainability advisory for corporates and organizations. Sovereign disaster risk finance for governments — combining 20+ years of practitioner experience with applied research at the frontier of climate analytics."
    primary={{ label: 'Book a Consultation', href: '/contact.html' }}
    secondary={{ label: 'View Services', href: '#services' }}
  />

  <!-- Two practices -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-intro center reveal">
        <span class="eyebrow">Two Practices, One Discipline</span>
        <h2 class="display-2">Built for governments and corporates navigating climate risk</h2>
        <p>Twenty years designing instruments that move from probabilistic risk analytics to executable financing and strategy — for ministries, multilaterals and boards.</p>
      </div>

      <div class="grid-2">
        <article class="card reveal">
          <span class="eyebrow">For Public Institutions</span>
          <h3 class="heading-3">Sovereign Disaster Risk Finance</h3>
          <p class="audience">Ministries of finance, central banks and multilateral development partners.</p>
          <ul class="service-list">
            <li><span class="marker">01</span><span>Catastrophe bonds and parametric insurance — design, structuring and placement.</span></li>
            <li><span class="marker">02</span><span>Risk-layered financing strategies and fiscal resilience diagnostics.</span></li>
            <li><span class="marker">03</span><span>Disaster fund design, governance and policy frameworks.</span></li>
          </ul>
          <a href="/government.html" class="btn-text">Explore Government Advisory</a>
        </article>

        <article class="card reveal">
          <span class="eyebrow">For Financial Institutions &amp; Corporates</span>
          <h3 class="heading-3">Climate Risk and Sustainability Advisory</h3>
          <p class="audience">Banks, insurers, infrastructure operators and listed corporates.</p>
          <ul class="service-list">
            <li><span class="marker">01</span><span>Physical climate risk assessments — asset-level exposure and portfolio AAL.</span></li>
            <li><span class="marker">02</span><span>Adaptation strategy and resilience investment prioritization.</span></li>
            <li><span class="marker">03</span><span>Disclosure support: TCFD, IFRS S2, OSFI — and board-ready reporting.</span></li>
          </ul>
          <a href="/corporate.html" class="btn-text">Explore Corporate Advisory</a>
        </article>
      </div>
    </div>
  </section>

  <Partners />

  <!-- Approach / metrics -->
  <section class="section section-dark metrics on-dark">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Approach</span>
        <h2 class="display-2">Quantitative rigour, translated into decisions</h2>
        <p>From probabilistic catastrophe modelling to placement of sovereign instruments and disclosure-grade portfolio analytics — every engagement leaves clients with tools, not just reports.</p>
      </div>
      <div class="metric-row">
        {metrics.map((m) => (
          <div class="reveal">
            <div class="metric-value">{m.value}</div>
            <p class="metric-label">{m.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Research strip -->
  <section class="section">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Research</span>
        <h2 class="display-2">Practice grounded in active research</h2>
        <p>Doctoral work at the University of British Columbia and ongoing publications keep the advisory practice at the frontier of disaster finance and climate analytics.</p>
      </div>
      <div class="research-list">
        {researchLines.map((r) => (
          <div class="research-item reveal">
            <h3 class="heading-4">{r.title}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:2rem"><a href="/research.html" class="btn-text">Explore research</a></p>
    </div>
  </section>

  <!-- Latest from the blog -->
  {posts.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <div class="section-intro reveal">
          <span class="eyebrow">Blog</span>
          <h2 class="display-2">Latest from the blog</h2>
          <p>One note a week on disaster risk finance, climate credit risk and the financial side of disasters.</p>
        </div>
        <div class="post-grid">
          {posts.map((p) => (
            <a href={`/blog/${p.id}.html`} class="post-card reveal">
              <div class="post-meta"><span class="tag">{p.data.tag}</span><time>{fmt(p.data.date)}</time></div>
              <h3 class="heading-4">{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:2rem"><a href="/blog.html" class="btn-text">All notes</a></p>
      </div>
    </section>
  )}

  <!-- Bio -->
  <section class="section">
    <div class="container bio-grid">
      <div class="bio-portrait reveal">
        <img src="/images/portrait.jpg" alt="Victor Cardenas-Santiago" width="400" height="400" loading="lazy" />
      </div>
      <div class="bio-content reveal">
        <span class="eyebrow">About</span>
        <h2 class="display-2">Practitioner with academic backing</h2>
        <p>{bio.short}</p>
        <p>Doctoral candidate at the University of British Columbia, where research focuses on compound flood risk to coastal infrastructure. Trusted advisor to the World Bank, UNDP, IDB, ADB and national governments.</p>
        <div class="credentials">
          <span class="credential">PhD Candidate, UBC</span>
          <span class="credential">Former Mexico Ministry of Finance</span>
          <span class="credential">Based in Vancouver, BC</span>
        </div>
        <p style="margin-top:1.5rem"><a href="/about.html" class="btn-text">Full profile</a></p>
      </div>
    </div>
  </section>
</Base>
