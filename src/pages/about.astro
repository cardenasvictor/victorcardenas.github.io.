---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import { bio, skills, site } from '../data/content';
---
<Base title="About" description="Victor Cardenas-Santiago — climate risk consultant and applied researcher with 20+ years in sovereign disaster risk finance.">
  <Hero
    compact
    eyebrow="About"
    title={site.name}
    sub="Climate risk consultant and applied researcher. Twenty years at the intersection of government policy, multilateral development banks and private financial markets."
    primary={{ label: 'Get in Touch', href: '/contact.html' }}
    secondary={{ label: 'LinkedIn', href: site.linkedin }}
  />

  <section class="section">
    <div class="container bio-grid">
      <div class="bio-portrait reveal">
        <img src="/images/portrait.jpg" alt="Victor Cardenas-Santiago" width="400" height="400" loading="lazy" />
      </div>
      <div class="bio-content reveal">
        <span class="eyebrow">Profile</span>
        <h2 class="display-2">Practitioner first, researcher by necessity</h2>
        {bio.long.map((p) => <p>{p}</p>)}
        <div class="credentials">
          <span class="credential">PhD Candidate, UBC IRES</span>
          <span class="credential">Consultant, Inter-American Development Bank</span>
          <span class="credential">Former Mexico Ministry of Finance</span>
          <span class="credential">Vancouver, BC · Mexico City</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Capabilities</span>
        <h2 class="display-2">What the work is built on</h2>
      </div>
      <div class="skills">
        {skills.map((s) => <div class="skill reveal">{s}</div>)}
      </div>
    </div>
  </section>

  <Partners />
</Base>
