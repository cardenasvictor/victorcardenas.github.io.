---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import { bio, skills, site } from '../data/content';
---
<Base title="About" description="Victor Cardenas-Santiago — climate risk consultant and applied researcher with 20+ years in sovereign disaster risk finance.">
  <Hero
    compact
    eyebrow="About"
    title={site.name}
    sub="Climate risk consultant and applied researcher. Twenty years at the intersection of government policy, multilateral development banks and private financial markets."
    primary={{ label: 'Get in Touch', href: './contact.html' }}
    secondary={{ label: 'LinkedIn', href: site.linkedin }}
  />

  <section class="section">
    <div class="container bio-grid">
      <div class="bio-portrait reveal" aria-hidden="true">
        <!-- Replace with /images/portrait.jpg when available -->
        <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%">
          <defs><linearGradient id="bg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0B2545"/><stop offset="1" stop-color="#143263"/></linearGradient></defs>
          <rect width="400" height="500" fill="url(#bg2)"/>
          <g stroke="#fff" stroke-opacity=".1" stroke-width=".5" fill="none">
            <path d="M0 100 Q100 80 200 100 T400 100"/><path d="M0 160 Q100 130 200 160 T400 160"/><path d="M0 220 Q100 185 200 220 T400 220"/><path d="M0 280 Q100 240 200 280 T400 280"/><path d="M0 340 Q100 290 200 340 T400 340"/><path d="M0 400 Q100 345 200 400 T400 400"/>
          </g>
          <line x1="40" y1="450" x2="100" y2="450" stroke="#14B8A6" stroke-width="2"/>
        </svg>
      </div>
      <div class="bio-content reveal">
        <span class="eyebrow">Profile</span>
        <h2 class="display-2">Practitioner first, researcher by necessity</h2>
        {bio.long.map((p) => <p>{p}</p>)}
        <div class="credentials">
          <span class="credential">PhD Candidate, UBC IRES</span>
          <span class="credential">Consultant, Inter-American Development Bank</span>
          <span class="credential">Former Mexico Ministry of Finance</span>
          <span class="credential">Vancouver, BC · Mexico City</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Capabilities</span>
        <h2 class="display-2">What the work is built on</h2>
      </div>
      <div class="skills">
        {skills.map((s) => <div class="skill reveal">{s}</div>)}
      </div>
    </div>
  </section>

  <Partners />
</Base>
