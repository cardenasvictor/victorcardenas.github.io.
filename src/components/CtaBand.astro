---
interface Props { title: string; body: string; label: string; href?: string; }
const { title, body, label, href = './contact.html' } = Astro.props;
---
<section class="section section-dark cta-band">
  <div class="container">
    <h2 class="display-2">{title}</h2>
    <p>{body}</p>
    <a href={href} class="btn btn-light">{label}</a>
  </div>
</section>
