---
import { site, nav } from '../data/content';
const current = Astro.url.pathname.replace(/^\//, '').replace(/\.html$/, '').replace(/\/$/, '');
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
const linkFor = (href: string) => `/${href}.html`;
---
<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-tagline">{site.tagline}</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {nav.map((item) => (
        <a href={linkFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="nav-right">
      <a href="/contact.html" class="btn btn-primary">Get in Touch</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-open="false">
    {nav.map((item) => (
      <a href={linkFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href="/contact.html" class="btn btn-primary">Get in Touch</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu?.setAttribute('data-open', String(!open));
  });
</script>
